{
  "name": "dsh-desktop",
  "productName": "DeepSeek Harness",
  "version": "1.0.0",
  "description": "Desktop shell for the DeepSeek Harness web GUI: one-click launch, no console, everything stops when the window closes. Cross-platform (Windows / macOS).",
  "license": "MIT",
  "author": {
    "name": "tianfuhan"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DeathEditor/dsh-desktop.git"
  },
  "private": true,
  "main": "src/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "setup": "electron . --setup",
    "test": "node build/test-locate.js",
    "verify": "node build/verify-contract.js",
    "icons": "powershell -NoProfile -ExecutionPolicy Bypass -File build/make-icons.ps1",
    "pack": "node build/run-electron-builder.js --dir",
    "dist": "node build/run-electron-builder.js"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "ai.deepseek.dsh.desktop",
    "productName": "DeepSeek Harness",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/icon.png",
      "assets/icon.ico",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools",
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeepSeek Harness"
    }
  }
}
